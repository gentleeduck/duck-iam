{
  "name": "@examples/duck-auth-nest",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts"
  },
  "dependencies": {
    "@examples/duck-auth-shared": "workspace:*",
    "@gentleduck/auth": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.21.0",
    "bun-types": "^1.3.10",
    "typescript": "^7.0.2"
  }
}
