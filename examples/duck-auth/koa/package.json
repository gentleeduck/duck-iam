    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts"
  },
  "dependencies": {
    "@examples/duck-auth-shared": "workspace:*",
    "@gentleduck/auth": "workspace:*",
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.7.0",
    "drizzle-orm": "^0.45.2",
    "koa": "^3.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/pg": "^8.21.0",
    "bun-types": "^1.3.10",
    "typescript": "^7.0.2"
  }
}
