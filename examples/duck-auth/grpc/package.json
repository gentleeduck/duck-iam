{
  "name": "@examples/duck-auth-grpc",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "client": "bun run src/client.ts"
  },
  "dependencies": {
    "@examples/duck-auth-shared": "workspace:*",
    "@gentleduck/auth": "workspace:*",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "bun-types": "^1.3.10",
    "typescript": "^7.0.2"
  }
}
