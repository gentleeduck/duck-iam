{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@gentleduck/duck-auth-demo",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down -v",
    "db:wait": "until docker exec duck-auth-demo-pg pg_isready -U duck -d duck_auth_demo >/dev/null 2>&1; do sleep 1; done",
    "db:migrate": "drizzle-kit push",
    "dev": "bun run --hot src/server.ts",
    "start": "bun src/server.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "check-types": "tsc --noEmit --pretty false",
    "all": "bash scripts/run-all.sh",
    "stop": "bash scripts/stop-all.sh",
    "clean": "rimraf node_modules .logs storybook-static"
  },
  "dependencies": {
    "@gentleduck/auth": "workspace:*",
    "@gentleduck/libs": "^1.0.0",
    "@gentleduck/registry-ui": "^0.4.4",
    "@gentleduck/variants": "^1.0.0",
    "@node-rs/argon2": "2.0.2",
    "@simplewebauthn/server": "^13.3.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8",
    "@storybook/react": "^10",
    "@storybook/react-vite": "^10",
    "@tailwindcss/vite": "^4.3.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.0",
    "storybook": "^8",
    "tailwindcss": "^4.3.0",
    "typescript": "catalog:",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
