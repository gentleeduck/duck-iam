# duck-auth — end-to-end test infrastructure
#
# E2E tests run against REAL Redis and REAL Postgres, not FakeRedis / in-memory
# sqlite. They are skipped automatically when these are unset, so `bun run test`
# stays green without infrastructure.
#
#   cp .env.example .env.test
#
# The containers come from the discord app's dev stack:
#   cd /Users/wildduck/Desktop/@duck/discord
#   docker compose -f docker/docker-compose.dev.yml up -d postgres redis
#
# Both are also declared in that repo's apps/server/.env, which is where these
# defaults come from.

# --- Redis -------------------------------------------------------------------
# Used for RedisSessionImpl, RedisLimiter, RedisIdempotency, RedisEvents.
# E2E tests namespace every key under `e2e:<random>:` and delete it afterwards,
# so pointing this at a shared dev Redis is safe.
DUCKAUTH_E2E_REDIS_URL=redis://localhost:6379

# --- Postgres ----------------------------------------------------------------
# MUST be a dedicated database. The suite creates and drops tables.
# Never point this at the app database.
#
#   docker exec gentleduck-dev-postgres \
#     psql -U gentleduck -d gentleduck -c "CREATE DATABASE duckauth_e2e;"
DUCKAUTH_E2E_DATABASE_URL=postgres://gentleduck:gentleduck@localhost:5432/duckauth_e2e

# --- Optional ----------------------------------------------------------------
# Number of processes to fan out for multi-instance revocation tests.
# Below 2, propagation tests are skipped — a single process cannot verify
# pub/sub fan-out, which is the whole point of that design.
DUCKAUTH_E2E_INSTANCES=2
