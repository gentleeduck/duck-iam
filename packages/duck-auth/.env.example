# duck-auth - end-to-end test infrastructure
#
# YOU PROBABLY DO NOT NEED THIS FILE.
#
# `bun run test` provisions throwaway Redis, Postgres and MySQL containers on ephemeral
# ports, seeds the shipped schema, and removes them when the run ends. See
# `src/test/e2e-containers.ts`. Without docker the e2e suites skip themselves and
# the rest of the suite still passes.
#
# Copy this to `.env.test` only to point the suites at infrastructure you already
# run. Anything set here wins, and no container is started for it.
#
#   cp .env.example .env.test

# --- Redis -------------------------------------------------------------------
# Used for RedisSessionImpl, RedisLimiter, RedisIdempotency, RedisEvents,
# RedisDPoPNonceStore. Every key is namespaced under `e2e:<random>:` and deleted
# afterwards, so a shared dev Redis is safe.
DUCKAUTH_E2E_REDIS_URL=redis://localhost:6379

# --- Postgres ----------------------------------------------------------------
# MUST be a dedicated database: the suites create tables from
# `src/test/pg-e2e-schema.sql` (regenerate with `bun run e2e:schema`). An empty
# database is enough. Never point this at the app database.
DUCKAUTH_E2E_DATABASE_URL=postgres://duckauth:duckauth@localhost:5432/duckauth_e2e

# --- MySQL -------------------------------------------------------------------
# MUST be a dedicated database: the suite creates tables from
# `src/test/mysql-e2e-schema.sql`. An empty database is enough.
DUCKAUTH_E2E_MYSQL_URL=mysql://root:duckauth@localhost:3306/duckauth_e2e

# --- Optional ----------------------------------------------------------------
# Number of processes to fan out for multi-instance revocation tests.
# Below 2, propagation tests are skipped: a single process cannot verify
# pub/sub fan-out, which is the whole point of that design.
DUCKAUTH_E2E_INSTANCES=2
